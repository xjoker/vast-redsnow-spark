# 必填。两个平台的环境变量表单都要填。
# 请求头 Authorization: Bearer <这个值>。日志里不会打印它。
API_TOKEN=

# 唯一目录。留空就是 /models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw。
# 平台盘不在 /models 时，把这一项指到那块盘上的同一层目录。不会再去别的路径找。
# 完整目录要有 tokenizer_config.json、model.safetensors.index.json，以及索引里列出的每个分片。
MODEL_DIR=
# 1：目录不完整就下载到上面这个路径。0：不下载。没有完整模型时不起推理，SSH 和认证代理继续。
MODEL_DOWNLOAD=1
MODEL_REPO=vcruz305/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
MODEL_REVISION=071adefe6c1c8de379d76977985811b7d4385454
# 同时下载的文件数。每个文件内部由 Xet 再并发。
# 中断后已完成的分片不重下，未完成的块留在模型目录的 .hf-cache。
MODEL_DOWNLOAD_WORKERS=8
# 留空则用上游 serve.sh 的 112。显式填写才覆盖。
GPU_SPLIT_GB=
CACHE_SIZE=262144
NUM_DRAFT_TOKENS=2
# 1：加载视觉塔，接受 image_url。0：省内存，带图请求返回 400。
VISION=1
# 单图 token 上限。留空用处理器默认 8000。越大越吃统一内存。
MAX_IMAGE_TOKENS=
PROXY_PORT=8898
SERVE_PORT=8899
PROXY_TIMEOUT=7200
# 容器日志里运行指标的间隔（秒）。0 关闭。
METRICS_INTERVAL=60

# 两个都留空则不启动。这时用服务器 IP 和 PROXY_PORT，请求头带 API_TOKEN。
# ET_NETWORK_NAME 和 ET_NETWORK_SECRET 都填才启动。不要填出口节点。
ET_NETWORK_NAME=
ET_NETWORK_SECRET=
# 逗号分隔。留空则只监听 tcp/udp 11010，等别人来连。
ET_PEERS=
# 留空且有 tun 时自动 DHCP。例如 10.144.144.2/24
ET_IPV4=
ET_HOSTNAME=redsnow

# 用户 tunnel 做在镜像里，没有密码。SSH_PASSWORD 只在启动时写入，不进镜像层。
# SSH_USER_PUBLIC_KEY 可以同时给。SSH_USER 留空就是 tunnel。登录后 sudo -i 是 root。
# root 只收平台注入的 SSH_PUBLIC_KEY，不能用密码。这和 Vast 的 SSH 约定一致。
# 22 端口在租用平台上常常是公网，密码至少 12 字符。
SSH_USER=
SSH_PASSWORD=
SSH_USER_PUBLIC_KEY=
# 逗号分隔，最多 16 个。留空则只允许转到 127.0.0.1:$PROXY_PORT。不要把未认证的 8899 加进来。
# 本机：ssh -N -L 8898:127.0.0.1:8898 tunnel@<主机>
SSH_TUNNELS=

# 1：用 cloudflared 把认证代理端口暴露到公网。0：关闭。
# CF_TUNNEL_TOKEN 留空是匿名快速隧道：每次重启地址都变、无可用性保证、同时最多 200 个请求。
CF_TUNNEL=1
# 填自己的 Cloudflare 具名隧道 token。在控制台把公网主机名指向 http://localhost:8898。
CF_TUNNEL_TOKEN=
