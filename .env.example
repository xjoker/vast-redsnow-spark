# 必填。两个平台的环境变量表单都要填。
API_TOKEN=

# 下面有默认值，表单留空即可。
# MODEL_DIR 留空时按顺序找：
#   $DATA_DIRECTORY/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
#   /vault/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
#   /workspace/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
MODEL_DIR=
# 留空则按启动时空闲显存取 min(112, floor(GiB)-2)
GPU_SPLIT_GB=
CACHE_SIZE=262144
NUM_DRAFT_TOKENS=2
PROXY_PORT=8898
SERVE_PORT=8899
PROXY_TIMEOUT=7200

# 填了才启动。留空不启动。这次只接 EasyTier。
# ET_NETWORK_NAME 和 ET_NETWORK_SECRET 都填才启动。不要填出口节点。
ET_NETWORK_NAME=
ET_NETWORK_SECRET=
# 逗号分隔。留空则只监听 tcp/udp 11010，等别人来连。
ET_PEERS=
# 留空且有 tun 时自动 DHCP。例如 10.144.144.2/24
ET_IPV4=
ET_HOSTNAME=redsnow

# 隧道用户。SSH_PASSWORD 或 SSH_USER_PUBLIC_KEY 至少填一个才创建，两个都可以同时给。
# SSH_USER 留空时用户名是 tunnel。登录后 sudo -i 就是 root，不用再输密码。
# 平台注入给 root 的公钥照旧可用。root 这个名字不能用密码登录。
# 22 端口在租用平台上常常是公网，密码至少 12 字符。
SSH_USER=
SSH_PASSWORD=
SSH_USER_PUBLIC_KEY=
# 逗号分隔，最多 16 个。留空则只允许转到 127.0.0.1:$PROXY_PORT。不要把未认证的 8899 加进来。
# 本机：ssh -N -L 8898:127.0.0.1:8898 tunnel@<主机>
SSH_TUNNELS=
