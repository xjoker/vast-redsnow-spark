# redsnow-exl3 environment variable template. Leaving a field empty in the deploy form = use the default.
# Values cannot contain spaces (Vast splits --env on spaces). Secrets go only in the deploy form, never in the image.

# ---- Required ----
# Bearer value for the auth proxy: header Authorization: Bearer <this value>. It is never printed in logs.
API_TOKEN=

# ---- Model and download ----
# The only model directory; no other path is searched. Empty = /models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw,
# in which case /models must be a mount point; without a mounted disk point it at a writable directory, e.g. Vast's /workspace/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw.
# A complete directory has tokenizer_config.json, model.safetensors.index.json and every shard listed in the index.
MODEL_DIR=
# 1: download if the directory is incomplete. 0: do not download; without a complete model inference is not started while SSH and the auth proxy keep running (for testing SSH and ports first).
MODEL_DOWNLOAD=1
MODEL_REPO=vcruz305/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
MODEL_REVISION=071adefe6c1c8de379d76977985811b7d4385454
# Number of files downloaded in parallel; Xet adds concurrency inside each file.
# After an interruption completed shards are not re-downloaded; unfinished chunks stay in .hf-cache in the model directory.
MODEL_DOWNLOAD_WORKERS=8

# ---- Inference ----
# VRAM split (-gs). Empty = 112 from upstream serve.sh; set it only to override.
GPU_SPLIT_GB=
# Context tokens (KV cache and --max-model-len). Input + max_tokens beyond this returns 400.
CACHE_SIZE=262144
# MTP draft tokens. 3 has a lower accept rate; default 2.
NUM_DRAFT_TOKENS=2
# Concurrent slots: requests generated at the same time, the rest queue. Positive integer. Total throughput does not grow with slots; above 1 set CACHE_SIZE=131072 and NUM_DRAFT_TOKENS=1; several long prompts prefilling at once can still make a request return 503.
MAX_ACTIVE_REQUESTS=1
# 1: load the vision tower and accept image_url. 0: save memory; requests with images return 400.
VISION=1
# Per-image token cap, positive integer. Empty = processor default 8000; larger values use more unified memory.
MAX_IMAGE_TOKENS=

# ---- Ports and logs ----
# Auth proxy port, listens on 0.0.0.0.
PROXY_PORT=8898
# Inference port, listens on 127.0.0.1 only, no auth, do not map it.
SERVE_PORT=8899
# Proxy-to-inference timeout (seconds).
PROXY_TIMEOUT=7200
# The proxy records host, GPU and inference samples from container start for the dashboard charts (GET /metrics/history).
# Seconds between samples, and hours of history kept in memory (about 8 MB at 5 s x 24 h).
HISTORY_INTERVAL=5
HISTORY_HOURS=24
# Interval (seconds) of the one-line runtime metrics in the container log (GPU, memory, active requests, public URL). 0 disables.
METRICS_INTERVAL=60
# Everything the container prints is also kept in LOG_DIR/redsnow.log (rotated), so it survives restarts.
# LOG_MAX_MB is the total size cap across all rotated files; 0 disables file logging.
LOG_DIR=/workspace/logs
LOG_MAX_MB=3072

# ---- Cloudflare tunnel ----
# 1: expose the auth proxy port publicly with cloudflared. 0: off.
# Through Cloudflare you must use stream:true; non-streaming requests over 100 s return 524.
CF_TUNNEL=1
# Empty = anonymous trycloudflare tunnel: the URL changes on every restart, no availability guarantee, at most 200 concurrent requests,
# the URL is in the container log and /run/redsnow/tunnel_url.
# Set your own named-tunnel token: in the dashboard point the public hostname's service URL at http://localhost:8898.
CF_TUNNEL_TOKEN=

# ---- SSH tunnel user ----
# root accepts only the platform-injected SSH_PUBLIC_KEY, no password; password login is for the tunnel user only, then sudo -i gives root.
# If both SSH_PASSWORD and SSH_USER_PUBLIC_KEY are empty no tunnel user is created. Port 22 is often public on rental platforms; use a password of at least 12 characters.
# SSH_USER empty = tunnel; must start with a lowercase letter and cannot be root.
SSH_USER=
SSH_PASSWORD=
SSH_USER_PUBLIC_KEY=
# Allowed forward targets, comma separated, at most 16. Empty = only 127.0.0.1:$PROXY_PORT. Do not add the unauthenticated 8899.
# Locally: ssh -N -L 8898:127.0.0.1:8898 tunnel@<host>
SSH_TUNNELS=

# ---- EasyTier (optional) ----
# The container has no TUN, so it runs no-tun: peers on the same network reach PROXY_PORT via the virtual IP. Peers must be publicly reachable addresses; 127.0.0.1 is useless.
# Both EASYTIER_NETWORK_NAME and EASYTIER_NETWORK_SECRET must be set to start; both empty = not started.
EASYTIER_NETWORK_NAME=
EASYTIER_NETWORK_SECRET=
# Comma separated, tcp://host:port or udp://host:port; a bad format exits at startup. Empty = only wait for others to connect.
EASYTIER_PEERS=
# Empty = DHCP assigns the virtual IP. Set e.g. 10.144.144.2/24 to pin it.
EASYTIER_IPV4=
EASYTIER_HOSTNAME=redsnow
# 1: private mode, nodes with a different secret are rejected. 0: off.
EASYTIER_PRIVATE_MODE=1
