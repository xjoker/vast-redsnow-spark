# redsnow-exl3 环境变量模板。部署表单里留空 = 使用默认值。
# 值里不能有空格（Vast 的 --env 按空格切分）。密钥只放部署表单，不进镜像。

# ---- 必填 ----
# 认证代理的 Bearer 值：请求头 Authorization: Bearer <这个值>。日志里不会打印它。
API_TOKEN=

# ---- 模型与下载 ----
# 唯一模型目录，不会去别的路径找。留空 = /models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw，
# 此时 /models 必须是挂载点；没挂盘时指到可写目录，如 Vast 的 /workspace/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw。
# 完整目录要有 tokenizer_config.json、model.safetensors.index.json，以及索引里列出的每个分片。
MODEL_DIR=
# 1：目录不完整就下载。0：不下载；没有完整模型时不起推理，SSH 和认证代理继续（先测 SSH 和端口用）。
MODEL_DOWNLOAD=1
MODEL_REPO=vcruz305/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
MODEL_REVISION=071adefe6c1c8de379d76977985811b7d4385454
# 同时下载的文件数；每个文件内部由 Xet 再并发。
# 中断后已完成的分片不重下，未完成的块留在模型目录的 .hf-cache。
MODEL_DOWNLOAD_WORKERS=8

# ---- 推理 ----
# 显存切分（-gs）。留空 = 上游 serve.sh 的 112，填了才覆盖。
GPU_SPLIT_GB=
# 上下文 token 数（KV 缓存和 --max-model-len）。输入 + max_tokens 超过返回 400。
CACHE_SIZE=262144
# MTP 草稿 token 数。3 的接受率更低，默认 2。
NUM_DRAFT_TOKENS=2
# 1：加载视觉塔，接受 image_url。0：省内存，带图请求返回 400。
VISION=1
# 单图 token 上限，正整数。留空 = 处理器默认 8000；越大越吃统一内存。
MAX_IMAGE_TOKENS=

# ---- 端口与日志 ----
# 认证代理端口，监听 0.0.0.0。
PROXY_PORT=8898
# 推理端口，只听 127.0.0.1，无鉴权，不要映射。
SERVE_PORT=8899
# 代理到推理的超时（秒）。
PROXY_TIMEOUT=7200
# 容器日志里一行运行指标（GPU、内存、进行中请求、公网地址）的间隔（秒）。0 关闭。
METRICS_INTERVAL=60

# ---- Cloudflare 隧道 ----
# 1：用 cloudflared 把认证代理端口暴露到公网。0：关闭。
# 经 Cloudflare 必须 stream:true，非串流超过 100 秒返回 524。
CF_TUNNEL=1
# 留空 = 匿名 trycloudflare 隧道：每次重启地址都变、无可用性保证、同时最多 200 个请求，
# 地址在容器日志和 /run/redsnow/tunnel_url。
# 填自己的具名隧道 token：在控制台把公网主机名的服务地址指向 http://localhost:8898。
CF_TUNNEL_TOKEN=

# ---- SSH 隧道用户 ----
# root 只收平台注入的 SSH_PUBLIC_KEY，不能用密码；密码登录只对隧道用户，登录后 sudo -i 即 root。
# SSH_PASSWORD 和 SSH_USER_PUBLIC_KEY 都留空则不创建隧道用户。22 端口在租用平台上常是公网，密码至少 12 字符。
# SSH_USER 留空 = tunnel，小写字母开头，不能是 root。
SSH_USER=
SSH_PASSWORD=
SSH_USER_PUBLIC_KEY=
# 允许转发的目标，逗号分隔，最多 16 个。留空 = 只允许 127.0.0.1:$PROXY_PORT。不要加入未认证的 8899。
# 本机：ssh -N -L 8898:127.0.0.1:8898 tunnel@<主机>
SSH_TUNNELS=

# ---- EasyTier（可选）----
# ET_NETWORK_NAME 和 ET_NETWORK_SECRET 都填才启动，都留空则不启动。不要填出口节点。
ET_NETWORK_NAME=
ET_NETWORK_SECRET=
# 逗号分隔。留空 = 只监听 tcp/udp 11010，等别人来连。
ET_PEERS=
# 留空且有 /dev/net/tun 时自动 DHCP。例如 10.144.144.2/24
ET_IPV4=
ET_HOSTNAME=redsnow
