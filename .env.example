# 必填。两个平台的环境变量表单都要填。
# 请求头 Authorization: Bearer <这个值>。日志里不会打印它。
API_TOKEN=

# 留空时先找已有权重，都没有就下载。
# 查找顺序：
#   $DATA_DIRECTORY/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
#   /vault/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
#   /workspace/models/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
# MODEL_DIR 填了就只用这个目录：完整则直接用，不完整则下载到这里。
MODEL_DIR=
MODEL_REPO=vcruz305/RED-SNOW-5.3-FLASH-EXL3-SAGE-2.49bpw
MODEL_REVISION=071adefe6c1c8de379d76977985811b7d4385454
# 同时下载的文件数。
MODEL_DOWNLOAD_WORKERS=8
# 留空则用上游 serve.sh 的 112。显式填写才覆盖。
GPU_SPLIT_GB=
CACHE_SIZE=262144
NUM_DRAFT_TOKENS=2
PROXY_PORT=8898
SERVE_PORT=8899
PROXY_TIMEOUT=7200

# 两个都留空则不启动。这时用服务器 IP 和 PROXY_PORT，请求头带 API_TOKEN。
# ET_NETWORK_NAME 和 ET_NETWORK_SECRET 都填才启动。不要填出口节点。
ET_NETWORK_NAME=
ET_NETWORK_SECRET=
# 逗号分隔。留空则只监听 tcp/udp 11010，等别人来连。
ET_PEERS=
# 留空且有 tun 时自动 DHCP。例如 10.144.144.2/24
ET_IPV4=
ET_HOSTNAME=redsnow

# 用户 tunnel 做在镜像里，没有密码。SSH_PASSWORD 只在启动时写入，不进镜像层。
# SSH_USER_PUBLIC_KEY 可以同时给。SSH_USER 留空就是 tunnel。登录后 sudo -i 是 root。
# root 只收平台注入的 SSH_PUBLIC_KEY，不能用密码。这和 Vast 的 SSH 约定一致。
# 22 端口在租用平台上常常是公网，密码至少 12 字符。
SSH_USER=
SSH_PASSWORD=
SSH_USER_PUBLIC_KEY=
# 逗号分隔，最多 16 个。留空则只允许转到 127.0.0.1:$PROXY_PORT。不要把未认证的 8899 加进来。
# 本机：ssh -N -L 8898:127.0.0.1:8898 tunnel@<主机>
SSH_TUNNELS=
