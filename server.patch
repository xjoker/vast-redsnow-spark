+# 模型自带 chat_template.jinja 为每个 image/image_url 部件输出的占位串。
+IMAGE_MARKER = "<|begin_of_image|><|image|><|end_of_image|>"
+
+
+def load_image(url, max_bytes):
+    """data: URI 或 http(s) URL -> PIL RGB 图。其他协议拒绝。"""
+    import base64
+    import io
+    import urllib.request
+    from PIL import Image
+    if url.startswith("data:"):
+        head, sep, data = url.partition(",")
+        if not sep or ";base64" not in head:
+            raise APIError("image_url data URI must be base64")
+        if len(data) > max_bytes * 4 // 3 + 4:
+            raise APIError("Image exceeds the size limit")
+        try:
+            raw = base64.b64decode(data, validate=True)
+        except ValueError as exc:
+            raise APIError("Invalid base64 image data") from exc
+    elif url.startswith(("http://", "https://")):
+        try:
+            with urllib.request.urlopen(url, timeout=20) as r:
+                raw = r.read(max_bytes + 1)
+        except Exception as exc:
+            raise APIError(f"Could not fetch image_url: {exc}") from exc
+        if len(raw) > max_bytes:
+            raise APIError("Image exceeds the size limit")
+    else:
+        raise APIError("image_url must be a data: URI or an http(s) URL")
+    try:
+        image = Image.open(io.BytesIO(raw))
+        image.load()
+    except Exception as exc:
+        raise APIError(f"Unreadable image: {exc}") from exc
+    return image.convert("RGB")
+
 
